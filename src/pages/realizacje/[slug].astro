---
/** Realization (case study) page — content in src/content/projects/<slug>.md (CMS → Realizacje). */
import { render } from 'astro:content';
import Img from '@/components/ui/Img.astro';
import DetailLayout from '@/layouts/DetailLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { getProjects, getSettings, getTemplates, projectPath } from '@/lib/content';
import { templateTitle, withOverrides } from '@/lib/seo';

export async function getStaticPaths() {
  const projects = await getProjects();
  const at = (i: number) => projects[(i + projects.length) % projects.length];
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // neighbours for the prev/next links (wrapping around)
      prev: projects.length > 1 ? at(i - 1) : undefined,
      next: projects.length > 1 ? at(i + 1) : undefined,
      total: projects.length,
    },
  }));
}

const { project, prev, next, total } = Astro.props;
const { Content } = await render(project);
const [settings, { project: t }] = await Promise.all([getSettings(), getTemplates()]);
const d = project.data;
---

<DetailLayout
  seo={withOverrides({ title: templateTitle(settings, `${d.title} — Realizacje`), description: d.excerpt, image: d.cover }, d.seo)}
  prefooter={t.prefooter}
  eyebrow={d.category}
  title={d.title}
  excerpt={d.excerpt}
  crumbs={[{ label: 'Realizacje', href: '/realizacje' }, { label: d.title }]}
  facts={[
    { label: 'Lokalizacja', value: d.location },
    { label: 'Rok', value: d.year },
    { label: 'Powierzchnia', value: d.area },
    { label: 'Czas realizacji', value: d.duration },
    { label: 'Zakres', value: d.scope },
  ]}
  cover={{ src: d.cover, alt: d.title }}
  ask={{ title: t.askTitle, text: t.askText, label: t.askButton, href: `/kontakt?realizacja=${encodeURIComponent(d.title)}` }}
  gallery={{ images: d.gallery, alt: (i) => `${d.title} — zdjęcie ${i + 2}` }}
>
  <div class="prose" data-reveal>
    <Content />
  </div>

  {
    prev && next && (
      <nav slot="after" class="pager theme-light" aria-label="Inne realizacje">
        <div class="container">
          <div class="pager__grid">
            {[
              { p: prev, side: 'prev' as const, label: 'Poprzednia realizacja' },
              { p: next, side: 'next' as const, label: 'Następna realizacja' },
            ].map(({ p, side, label }) => (
              <a href={projectPath(p.id)} class:list={['pager__link', `pager__link--${side}`]} rel={side}>
                <span class="pager__media">
                  <Img src={p.data.cover} sizes="(min-width: 768px) 50vw, 100vw" alt="" loading="lazy" width="1024" height="1280" />
                </span>
                <span class="pager__text">
                  <span class="pager__dir">
                    {side === 'prev' && <Icon name="arrow-left" />}
                    {label}
                    {side === 'next' && <Icon name="arrow-right" />}
                  </span>
                  <span class="pager__title">{p.data.title}</span>
                  <span class="pager__meta">{[p.data.location, p.data.year].filter(Boolean).join(' · ')}</span>
                </span>
              </a>
            ))}
          </div>
          <div class="pager__all">
            <a href="/realizacje" class="btn btn--ghost">
              Wszystkie realizacje ({total})
            </a>
          </div>
        </div>
      </nav>
    )
  }
</DetailLayout>

<style lang="scss">
  /* ---------- prev / next ---------- */
  .pager {
    padding-bottom: var(--section-y);
  }

  .pager__grid {
    display: grid;
    gap: 1px;
    background: var(--line); // hairline between the two halves
    border-block: 1px solid var(--line);

    @include up(md) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager__link {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0;
    background: var(--bg);

    @include up(md) {
      grid-template-columns: 8rem 1fr;
    }

    @include hover {
      .pager__media img {
        transform: scale(1.06);
      }

      .pager__title {
        text-decoration-color: currentColor;
      }
    }
  }

  // next: image on the right, text right-aligned
  .pager__link--next {
    @include up(md) {
      grid-template-columns: 1fr 8rem;
      padding-left: 1.5rem;
      text-align: right;

      .pager__media {
        order: 2;
      }

      .pager__dir {
        justify-content: flex-end;
      }
    }
  }

  .pager__link--prev {
    @include up(md) {
      padding-right: 1.5rem;
    }
  }

  .pager__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-alt);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.9s var(--ease-out);
    }
  }

  .pager__text {
    display: grid;
    gap: 0.35rem;
  }

  .pager__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    @include label;
    color: var(--accent);

    :global(.icon) {
      width: 0.875rem;
      stroke-width: 1.5;
    }
  }

  .pager__title {
    @include display(var(--fs-h3));
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.3s;
  }

  .pager__meta {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .pager__all {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }
</style>
