---
/** Catalog design page (ready-made house design) — content in src/content/catalog/<slug>.md (CMS → Katalog projektów). */
import { render } from 'astro:content';
import DetailLayout from '@/layouts/DetailLayout.astro';
import DesignCard from '@/components/cards/DesignCard.astro';
import ZoomImage from '@/components/detail/ZoomImage.astro';
import Icon from '@/components/ui/Icon.astro';
import { getCatalog, getSettings, getTemplates } from '@/lib/content';
import { templateTitle, withOverrides } from '@/lib/seo';

export async function getStaticPaths() {
  const designs = await getCatalog();
  return designs.map((design, i) => ({
    params: { slug: design.id },
    // "see also": the next designs in catalog order (wrapping), max 3
    props: {
      design,
      others: [...designs.slice(i + 1), ...designs.slice(0, i)].slice(0, 3),
      total: designs.length,
    },
  }));
}

const { design, others, total } = Astro.props;
const { Content } = await render(design);
const [settings, { catalog: t }] = await Promise.all([getSettings(), getTemplates()]);
const d = design.data;
const modifications = d.modifications.length ? d.modifications : t.modifications;
---

<DetailLayout
  seo={withOverrides({ title: templateTitle(settings, `${d.title} — Katalog projektów`), description: d.excerpt, image: d.image }, d.seo)}
  prefooter={t.prefooter}
  eyebrow={t.eyebrow}
  title={d.title}
  excerpt={d.excerpt}
  crumbs={[{ label: 'Katalog', href: '/katalog' }, { label: d.title }]}
  facts={[
    { label: 'Powierzchnia', value: `${d.area} m²` },
    { label: 'Pokoje', value: d.rooms },
    { label: 'Kondygnacje', value: d.floors === 'parterowy' ? 'Parterowy' : 'Z poddaszem' },
    { label: 'Wyróżnik', value: d.feature },
  ]}
  cover={{ src: d.image, alt: `Projekt domu ${d.title}` }}
  ask={{ title: t.askTitle, text: t.askText, label: t.askButton, href: `/kontakt?projekt=${encodeURIComponent(d.title)}` }}
  gallery={{ images: d.gallery, alt: (i) => `${d.title} — wizualizacja ${i + 2}`, label: 'Wizualizacje' }}
>
  {
    t.standards.length > 0 && (
      <ul slot="ask" role="list" class="standards">
        {t.standards.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    )
  }

  <div class="prose" data-reveal>
    <Content />
  </div>

  {
    modifications.length > 0 && (
      <div data-reveal>
        <h2 class="mods__title">{t.modificationsTitle}</h2>
        <ul role="list" class="mods__list">
          {modifications.map((m) => (
            <li>
              <Icon name="check" />
              {m}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    d.plans.length > 0 && (
      <div data-reveal>
        <h2 class="mods__title">Rzuty</h2>
        <ul role="list" class="plans__grid">
          {d.plans.map((p, i) => (
            <li>
              <ZoomImage src={p.image} alt={`${d.title} — ${p.label ?? `rzut ${i + 1}`}`} variant="plan" />
              {p.label && <p class="plans__label">{p.label}</p>}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    others.length > 0 && (
      <section slot="after" class="more theme-light" aria-labelledby="more-title">
        <div class="container">
          <header class="section-head more__head">
            <div class="section-head__text">
              <p class="eyebrow">Katalog</p>
              <h2 class="display" id="more-title">
                Zobacz też
              </h2>
            </div>
            <a href="/katalog" class="btn btn--ghost btn--baseline">
              Wszystkie projekty ({total})
            </a>
          </header>
          <ul role="list" class="more__grid">
            {others.map((o) => (
              <li>
                <DesignCard design={o} headingLevel="h3" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</DetailLayout>

<style lang="scss">
  // the three standards inside the ask box
  .standards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;

    li {
      padding: 0.4rem 0.75rem;
      font-size: 0.75rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--c-white);
    }
  }

  .mods__title {
    @include display(var(--fs-h3));
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .mods__list {
    display: grid;

    @include up(md) {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
    }

    li {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      padding-block: 0.95rem;
      border-bottom: 1px solid var(--line);
      font-size: var(--fs-small);
    }

    :global(.icon) {
      flex: none;
      width: 1rem;
      height: 1rem;
      margin-top: 0.15rem;
      stroke-width: 1.5;
      color: var(--accent);
    }
  }

  .plans__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;

    @include up(md) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .plans__label {
    margin-top: 0.6rem;
    @include label;
    color: var(--muted);
  }

  /* ---------- see also ---------- */
  .more {
    padding-bottom: var(--section-y);
  }

  .more__head {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .more__grid {
    display: grid;
    gap: 2.5rem clamp(1rem, 2vw, 1.5rem);

    @include up(md) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
