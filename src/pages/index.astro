---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Marquee from '@/components/home/Marquee.astro';
import About from '@/components/home/About.astro';
import Projects from '@/components/home/Projects.astro';
import Process from '@/components/home/Process.astro';
import Instagram from '@/components/home/Instagram.astro';
import Contact from '@/components/home/Contact.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { getHome, getProjects, getSettings } from '@/lib/content';
import { formatRating, getGooglePlace } from '@/lib/google';

const [home, settings, projects, google] = await Promise.all([getHome(), getSettings(), getProjects(), getGooglePlace()]);
const featured = projects.filter((p) => p.data.featured);

// Live Google score (when configured) replaces the CMS value in any hero badge / stat whose label mentions "Google".
const mentionsGoogle = (label: string) => /google/i.test(label);
const hero = google
  ? {
      ...home.hero,
      badges: home.hero.badges.map((b) => (mentionsGoogle(b.label) ? { ...b, value: `${formatRating(google.rating)} ★` } : b)),
    }
  : home.hero;
const stats = google
  ? home.stats.map((s) => (mentionsGoogle(s.label) ? { ...s, value: Math.round(google.rating * 10) / 10, decimals: 1 } : s))
  : home.stats;
---

<BaseLayout title={home.seo.title} description={home.seo.description} image={home.hero.image}>
  <Hero data={hero} />
  <Marquee items={home.marquee} />
  <About data={home.about} stats={stats} />
  <Projects intro={home.projects} projects={(featured.length ? featured : projects).slice(0, 3)} total={projects.length} />
  <Process data={home.process} />
  {home.instagram && <Instagram data={home.instagram} settings={settings} />}
  <CtaBanner {...home.cta} />
  {home.contact && <Contact intro={home.contact} settings={settings} />}
</BaseLayout>
