---
/**
 * Document shell for every page: <head> (SEO, social cards, structured data, fonts),
 * header, optional band above the footer, footer and the animation bundle.
 */
import '@fontsource-variable/inter/index.css';
// Preloaded so the first paint already uses Inter (latin + latin-ext covers Polish ą ę ł ś ż …)
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import '@/styles/global.scss';

import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PreFooter from '@/components/layout/PreFooter.astro';
import type { PrefooterVariant } from '@/schemas/common';
import { getSettings } from '@/lib/content';
import { normalizePath } from '@/lib/format';
import { shareImage } from '@/lib/images';
import { breadcrumbs, localBusiness, website, type Crumb, type JsonLd, type PageSeo } from '@/lib/seo';

interface Props {
  /** final <title>, description, share image, noindex */
  seo: PageSeo;
  /** overlay: transparent header over a photo/green hero; solid: white bar from the start */
  header?: 'overlay' | 'solid';
  /** Beige band above the footer. */
  prefooter?: PrefooterVariant;
  /** White band instead of beige (used when the last section above it is beige). */
  prefooterLight?: boolean;
  /** Breadcrumb trail after "Strona główna" → BreadcrumbList for Google */
  crumbs?: Crumb[];
  /** Extra structured data (FAQ, …) */
  jsonLd?: (JsonLd | undefined)[];
}

const { seo, header = 'overlay', prefooter = 'quote', prefooterLight = false, crumbs, jsonLd = [] } = Astro.props;
const settings = await getSettings();
const site = Astro.site!;
const path = normalizePath(Astro.url.pathname);
const isHome = path === '/';

const description = seo.description ?? settings.tagline;
const canonical = new URL(path, site);
const ogImage = new URL(await shareImage(seo.image ?? settings.seo.image), site);
const companyImage = new URL(await shareImage(settings.seo.image), site);

const structuredData = [
  localBusiness(settings, site, companyImage),
  isHome && website(settings, site),
  crumbs?.length && breadcrumbs(crumbs, canonical, site),
  ...jsonLd,
].filter(Boolean);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatinExt} as="font" type="font/woff2" crossorigin />

    <title>{seo.title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}
    {settings.seo.googleVerification && <meta name="google-site-verification" content={settings.seo.googleVerification} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#063424" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={settings.companyName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Animation pre-state: hide reveal targets only when JS + motion are available.
         Failsafe un-hides everything if the animation bundle hasn't started in 2.5s. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('no-anim');
        window.__animFailsafe = setTimeout(function () {
          d.classList.add('no-anim');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header settings={settings} variant={header} />
    <main id="main">
      <slot />
      {prefooter !== 'none' && <PreFooter variant={prefooter} light={prefooterLight} />}
    </main>
    <Footer settings={settings} wordmark={isHome} />

    <script>
      import { initAnimations } from '@/scripts/animations';
      initAnimations();
    </script>
  </body>
</html>
