---
/**
 * Google rating badge: ★★★★★  5,0 / 5 z 3 opinii w Google
 * Uses the real score/count (live Places API data, or the CMS fallback) and links to the listing.
 */
import star from '@/assets/icons/star.svg?raw';
import { formatRating, getRating } from '@/lib/google';

interface Props {
  class?: string;
  /** compact: slim pill (footer) */
  compact?: boolean;
}
const rating = await getRating();
const starSvg = star.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const five = Array.from({ length: 5 }, () => starSvg);
const fill = rating ? Math.min(100, (rating.score / 5) * 100) : 0;
---

{
  rating && (
    <a
      href={rating.url ?? '#'}
      class:list={['g-rating', { 'g-rating--compact': Astro.props.compact }, Astro.props.class]}
      target={rating.url ? '_blank' : undefined}
      rel={rating.url ? 'noopener noreferrer' : undefined}
      aria-label={`Ocena ${formatRating(rating.score)} na 5 z ${rating.count} opinii w Google — zobacz opinie`}
    >
      <span class="g-rating__stars" aria-hidden="true" style={`--fill: ${fill}%`}>
        <span class="g-rating__row g-rating__row--base">{five.map((s) => <span set:html={s} />)}</span>
        <span class="g-rating__row g-rating__row--fill">{five.map((s) => <span set:html={s} />)}</span>
      </span>
      <span class="g-rating__text" aria-hidden="true">
        {formatRating(rating.score)} / 5 z {rating.count} opinii w
      </span>
      <span class="g-rating__google" aria-hidden="true">
        <span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span
          style="color:#4285F4">g</span
        ><span style="color:#34A853">l</span><span style="color:#EA4335">e</span>
      </span>
    </a>
  )
}

<style lang="scss">
  .g-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 1.25rem;
    border-radius: 0.875rem;
    background: var(--c-white);
    color: #3c4043;
    box-shadow: 0 6px 24px -10px rgb(6 52 36 / 0.35);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s;

    @include hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px -10px rgb(6 52 36 / 0.45);
    }
  }

  // empty stars + gold stars clipped to the score
  .g-rating__stars {
    position: relative;
    display: inline-block;
    line-height: 0;
  }

  .g-rating__row {
    display: flex;
    gap: 0.15rem;

    :global(svg) {
      width: 1.2rem;
      height: 1.2rem;
    }
  }

  .g-rating__row--base {
    color: #e3e3e3;
  }

  .g-rating__row--fill {
    position: absolute;
    inset: 0;
    color: #fbbc04;
    clip-path: inset(0 calc(100% - var(--fill, 100%)) 0 0);
  }

  .g-rating__text {
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .g-rating__google {
    font-family: 'Google Sans', 'Product Sans', Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-top: -0.1rem;
  }

  // slim pill for the footer
  .g-rating--compact {
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 99px;
    box-shadow: none;

    .g-rating__row {
      gap: 0.1rem;

      :global(svg) {
        width: 0.8rem;
        height: 0.8rem;
      }
    }

    .g-rating__text {
      font-size: 0.75rem;
    }

    .g-rating__google {
      font-size: 0.9375rem;
    }

    @include hover {
      box-shadow: none;
    }
  }

  @include down(sm) {
    .g-rating:not(.g-rating--compact) {
      gap: 0.6rem;
      padding: 0.7rem 1rem;
    }

    .g-rating__text {
      font-size: 0.8125rem;
    }

    .g-rating__google {
      font-size: 1.0625rem;
    }
  }
</style>
