---
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { mapUrl, telHref, type Home, type Settings } from '@/lib/content';

interface Props {
  intro: NonNullable<Home['contact']>;
  settings: Settings;
}
const { intro, settings } = Astro.props;

const details = [
  settings.phone && { icon: 'phone', label: 'Telefon', value: settings.phone, href: telHref(settings.phone) },
  settings.email && { icon: 'mail', label: 'E-mail', value: settings.email, href: `mailto:${settings.email}` },
  settings.address && {
    icon: 'pin',
    label: 'Biuro',
    value: `${settings.address}, ${settings.city ?? ''}`,
    href: mapUrl(settings.socials),
    external: true,
  },
  settings.hours && { icon: 'clock', label: 'Godziny pracy', value: settings.hours },
].filter(Boolean) as {
  icon: 'phone' | 'mail' | 'pin' | 'clock';
  label: string;
  value: string;
  href?: string;
  external?: boolean;
}[];
---

<section class="contact section theme-light" id="kontakt">
  <div class="container contact__grid">
    <div class="contact__info">
      {intro.eyebrow && <p class="eyebrow" data-reveal>{intro.eyebrow}</p>}
      {intro.title && <h2 class="display contact__title" data-split>{intro.title}</h2>}
      {intro.text && <p class="lead" data-reveal>{intro.text}</p>}

      <ul role="list" class="contact__details" data-reveal-stagger>
        {
          details.map((d) => (
            <li>
              <span class="contact__icon">
                <Icon name={d.icon} />
              </span>
              <span class="contact__label">{d.label}</span>
              {d.href ? (
                <a
                  href={d.href}
                  class="contact__value"
                  target={d.external ? '_blank' : undefined}
                  rel={d.external ? 'noopener noreferrer' : undefined}
                >
                  {d.value}
                </a>
              ) : (
                <span class="contact__value">{d.value}</span>
              )}
            </li>
          ))
        }
      </ul>

      <SocialLinks socials={settings.socials} class="contact__socials" />
    </div>

    <div class="contact__card" data-reveal>
      <h3 class="contact__card-title">Napisz do nas</h3>
      <ContactForm />
    </div>
  </div>
</section>

<style lang="scss">
  .contact__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);

    @include up(lg) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact__info {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact__details {
    margin-top: 1rem;
    border-top: 1px solid var(--line);

    li {
      display: grid;
      grid-template-columns: 1.5rem 1fr auto;
      column-gap: 0.75rem;
      align-items: center;
      padding-block: 1rem;
      border-bottom: 1px solid var(--line);
    }
  }

  .contact__icon {
    display: grid;
    place-items: center;
    color: var(--muted);

    :global(.icon) {
      width: 1rem;
      stroke-width: 1.5;
    }
  }

  .contact__label {
    @include label;
    color: var(--muted);
  }

  .contact__value {
    text-align: right;
  }

  a.contact__value {
    justify-self: end;
    background: linear-gradient(currentColor, currentColor) no-repeat right bottom / 0 1px;
    transition: background-size 0.4s var(--ease-out);

    @include hover {
      background-size: 100% 1px;
    }
  }

  .contact__info :global(.contact__socials) {
    --socials-size: 1.375rem;
    margin-top: 0.75rem;
    color: var(--c-green);
  }

  .contact__card {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--c-paper);
  }

  .contact__card-title {
    @include display(var(--fs-h3));
    margin-bottom: 1.5rem;
  }

  @include down(sm) {
    .contact__details li {
      grid-template-columns: 1.5rem 1fr;
    }

    .contact__value,
    a.contact__value {
      grid-column: 2;
      text-align: left;
      justify-self: start;
    }
  }
</style>
