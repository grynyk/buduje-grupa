---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '@/components/ProjectCard.astro';
import type { Home } from '@/lib/content';

interface Props {
  intro: Home['projects'];
  projects: CollectionEntry<'projects'>[];
  total: number;
}
const { intro, projects, total } = Astro.props;
---

<section class="projects section theme-paper" id="realizacje">
  <div class="container">
    <header class="projects__head">
      <div class="projects__heading">
        {intro.eyebrow && <p class="eyebrow" data-reveal>{intro.eyebrow}</p>}
        {intro.title && <h2 class="display projects__title" data-split>{intro.title}</h2>}
      </div>
      <a href="/realizacje" class="btn btn--ghost btn--baseline projects__all" data-reveal>Wszystkie realizacje ({total})</a>
    </header>

    <ul role="list" class="projects__row card-grid" data-reveal-stagger>
      {
        projects.map((p, i) => (
          <li class="projects__item">
            <ProjectCard project={p} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .projects__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .projects__heading {
    display: grid;
    gap: 1.25rem;
  }

  .projects__all {
    flex: none;
  }

  // One aligned row: all cards share the same top edge and size.
  // Below lg the row scrolls sideways (snap) instead of stacking.
  .projects__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 22rem);
    column-gap: clamp(1rem, 2vw, 1.5rem);
    row-gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @include up(md) {
      grid-auto-columns: calc((100% - 1.5rem) / 2.2);
    }

    @include up(lg) {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }
  }

  .projects__item {
    scroll-snap-align: start;
    min-width: 0;
  }
</style>
