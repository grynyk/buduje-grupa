---
/**
 * Home hero — one 12-column grid shared by the headline row and the stats row:
 *
 *   ┌──────────── cols 1–7 ────────────┬──── cols 8–12 ────┐
 *   │ eyebrow                          │                   │
 *   │ Title line 1                     │                   │
 *   │ Title line 2                     │ subtitle          │
 *   │ Title line 3 ── baseline ────────┼─ buttons (bottom) │
 *   ├──────────── hairline across all 12 columns ──────────┤
 *   │ stat 1          │ stat 2         │ stat 3       (↓)  │
 *   └─────────────────┴────────────────┴───────────────────┘
 *  Stat 3 starts on col 8, i.e. exactly under the subtitle column.
 */
import Icon from '@/components/Icon.astro';
import type { Home } from '@/lib/content';

interface Props {
  data: Home['hero'];
}
const { data } = Astro.props;
---

<section class="hero theme-dark" data-hero>
  <div class="hero__media" data-hero-media>
    <img src={data.image} alt="" width="1536" height="864" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content container">
    <div class="hero__grid">
      <div class="hero__main">
        {data.eyebrow && <p class="eyebrow hero__eyebrow" data-hero-fade>{data.eyebrow}</p>}
        <h1 class="hero__title">
          {
            data.titleLines.map((line) => (
              <span class="hero__line">
                <span class="hero__line-inner" data-hero-line>
                  {line}
                </span>
              </span>
            ))
          }
        </h1>
      </div>

      <div class="hero__aside">
        {data.subtitle && <p class="hero__subtitle" data-hero-fade>{data.subtitle}</p>}
        <div class="hero__ctas" data-hero-fade>
          <a href={data.primaryCta.href} class="btn">
            {data.primaryCta.label}
          </a>
          {
            data.secondaryCta && (
              <a href={data.secondaryCta.href} class="btn btn--ghost">
                {data.secondaryCta.label}
              </a>
            )
          }
        </div>
      </div>
    </div>

    {
      data.badges.length > 0 && (
        <div class="hero__meta">
          <ul role="list" class="hero__stats">
            {data.badges.map((b) => (
              <li class="hero__stat" data-hero-badge>
                <strong>{b.value}</strong>
                <span>{b.label}</span>
              </li>
            ))}
          </ul>
          <a href="#o-nas" class="hero__scroll" data-hero-fade aria-label="Przewiń do sekcji O nas">
            <Icon name="arrow-down" />
          </a>
        </div>
      )
    }
  </div>
</section>

<style lang="scss">
  .hero {
    // shared grid + vertical rhythm
    --hero-gap: clamp(1rem, 1.6vw, 1.5rem); // column gap
    --hero-space: clamp(2.5rem, 4.5vw, 4rem); // between headline row and stats row
    --hero-size: clamp(3rem, 1.4rem + 6vw, 6.75rem); // title size

    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 2rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;

    img {
      @include cover-media;
      object-position: 60% 35%;
    }
  }

  // Legibility: green-tinted shade, heaviest bottom-left where the copy sits; top stays clear for the header.
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(var(--shade) / 0.5) 0%, rgb(var(--shade) / 0) 22%),
      linear-gradient(0deg, rgb(var(--shade) / 0.92) 0%, rgb(var(--shade) / 0.55) 38%, rgb(var(--shade) / 0) 70%),
      linear-gradient(90deg, rgb(var(--shade) / 0.55) 0%, rgb(var(--shade) / 0.15) 55%, rgb(var(--shade) / 0) 80%);
  }

  .hero__content {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ---------- headline row ---------- */
  .hero__grid {
    display: grid;
    gap: 2rem var(--hero-gap);

    @include up(lg) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
  }

  .hero__main {
    @include up(lg) {
      grid-column: 1 / span 7;
    }
  }

  .hero__aside {
    display: grid;
    gap: 1.75rem;
    max-width: 34rem;

    @include up(lg) {
      grid-column: 8 / -1;
      // sit the buttons' bottom edge on the title's baseline (line box bottom − descender)
      padding-bottom: calc(var(--hero-size) * 0.155); // measured Jost descender at this line-height
    }
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
    color: rgb(255 255 255 / 0.85);
  }

  .hero__title {
    @include display(var(--hero-size));
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    // room for descenders/diacritics while masked
    padding-block: 0.06em;
    margin-block: -0.06em;
  }

  .hero__line-inner {
    display: block;
  }

  .hero__subtitle {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.88);
  }

  // Buttons side by side; on phones (too narrow for two) they stack at equal width.
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;

    .btn {
      flex: 1 1 auto;
    }

    .btn--ghost {
      --btn-border: rgb(255 255 255 / 0.6);
    }

    @include up(sm) {
      flex-wrap: nowrap;

      .btn {
        flex: 0 0 auto;
      }
    }
  }

  /* ---------- stats row (same 12-col grid) ---------- */
  .hero__meta {
    position: relative;
    margin-top: var(--hero-space);
    padding-top: clamp(1.25rem, 2vw, 1.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.28);

    @include up(lg) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--hero-gap);
      align-items: center;
    }
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem var(--hero-gap);

    @include up(md) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    // join the parent grid so each stat lands on the hero columns
    @include up(lg) {
      display: contents;
    }
  }

  .hero__stat {
    display: grid;
    gap: 0.35rem;

    @include up(lg) {
      &:nth-child(1) {
        grid-column: 1 / span 4;
      }

      &:nth-child(2) {
        grid-column: 5 / span 3;
      }

      &:nth-child(3) {
        grid-column: 8 / span 4; // aligned with the subtitle column
      }
    }

    strong {
      @include display(clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem));
      font-weight: 400;
      line-height: 1.2;
    }

    span {
      @include label;
      color: rgb(255 255 255 / 0.72);
    }

    @include down(md) {
      &:nth-child(n + 3) {
        display: none;
      }
    }
  }

  .hero__scroll {
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 50%;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;

    :global(.icon) {
      width: 1rem;
      stroke-width: 1.5;
    }

    @include up(lg) {
      display: grid;
      grid-column: 12;
      grid-row: 1;
      justify-self: end;
    }

    @include hover {
      background: var(--c-white);
      border-color: var(--c-white);
      color: var(--c-green);
    }
  }
</style>
