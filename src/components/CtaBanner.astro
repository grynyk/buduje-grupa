---

interface Props {
  title: string;
  text?: string;
  image: string;
  button: { label: string; href: string };
}
const { title, text, image, button } = Astro.props;
---

<section class="cta theme-dark">
  <div class="cta__media" aria-hidden="true">
    <img src={image} alt="" loading="lazy" width="1536" height="864" data-parallax="18" />
  </div>
  <div class="cta__inner container">
    <h2 class="cta__title" data-split>{title}</h2>
    <div class="cta__aside" data-reveal>
      {text && <p class="lead">{text}</p>}
      <a href={button.href} class="btn">{button.label}</a>
    </div>
  </div>
</section>

<style lang="scss">
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(6rem, 14vw, 12rem);

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(100deg, rgb(6 52 36 / 0.92) 25%, rgb(6 52 36 / 0.55));
    }
  }

  // Parallax: the photo lags behind the scroll (data-parallax="18" → moves −18% → +18% of its height).
  // The layer overhangs the section by 30% top and bottom; 18% × 1.6 (its height) < 30%, so no edge ever shows.
  .cta__media {
    position: absolute;
    inset: -30% 0;
    z-index: -2;

    img {
      @include cover-media;
    }
  }

  .cta__inner {
    display: grid;
    gap: 2.5rem 5rem;

    @include up(lg) {
      grid-template-columns: 1.5fr 1fr;
      align-items: end;
    }
  }

  .cta__title {
    @include display(var(--fs-h1));
    line-height: 1.05;
  }

  .cta__aside {
    display: grid;
    gap: 2rem;
    justify-items: start;

    .lead {
      color: rgb(255 255 255 / 0.82);
    }
  }
</style>
