---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  class?: string;
  headingLevel?: 'h2' | 'h3';
}
const { project, index, class: className, headingLevel: Heading = 'h3' } = Astro.props;
const { title, category, location, year, cover, area } = project.data;
---

<article class:list={['card', className]} data-category={category}>
  <a href={`/realizacje/${project.id}`} class="card__link">
    <div class="card__media">
      <img src={cover} alt={title} loading="lazy" width="1024" height="1280" />
      <span class="card__tag">{category}</span>
    </div>
    <div class="card__body">
      <div class="card__head">
        <Heading class="card__title">{title}</Heading>
        <span class="card__more" aria-hidden="true">Zobacz <Icon name="arrow-right" /></span>
      </div>
      <p class="card__meta">
        {typeof index === 'number' && <span class="card__index">{String(index + 1).padStart(2, '0')}</span>}
        {[location, year, area].filter(Boolean).map((v) => <span>{v}</span>)}
      </p>
    </div>
  </a>
</article>

<style lang="scss">
  .card__link {
    display: block;
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-alt);

    img {
      @include cover-media;
      transition: transform 1.1s var(--ease-out);
    }
  }

  .card__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    padding: 0.4rem 0.75rem;
    font-size: 0.6875rem;
    line-height: 1;
    background: var(--c-white);
    color: var(--c-green);
    border-radius: 99px;
  }

  .card__body {
    padding-top: 1.1rem;
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .card__title {
    @include display(clamp(1.25rem, 1.1rem + 0.5vw, 1.625rem));
    line-height: 1.15;
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    @include label;

    :global(.icon) {
      width: 0.875rem;
      height: 0.875rem;
      stroke-width: 1.5;
      transition: transform 0.45s var(--ease-out);
    }
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .card__index {
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .card__link:hover {
      .card__media img {
        transform: scale(1.05);
      }

      .card__more :global(.icon) {
        transform: translateX(3px);
      }
    }
  }

  /* ---- Shared rows inside a `.card-grid` list ----
     Each <li> spans 3 rows of the parent grid (photo / title line / details) via subgrid,
     so titles that wrap differently can never push one card's divider out of line. */
  :global(.card-grid) > :global(li) {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  :global(.card-grid) .card,
  :global(.card-grid) .card__link,
  :global(.card-grid) .card__body {
    display: contents;
  }

  :global(.card-grid) .card__head {
    align-items: end;
    padding-top: 1.1rem;
  }

  // the link has no box in this mode, so show its focus ring on the photo
  :global(.card-grid) .card__link:focus-visible .card__media {
    outline: 1px solid var(--fg);
    outline-offset: 3px;
  }
</style>
