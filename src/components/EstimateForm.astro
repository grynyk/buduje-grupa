---
/** "Ile może kosztować Twój dom?" — cost-estimate request (Web3Forms). */
import Icon from './Icon.astro';

interface Props {
  standards: string[];
  buttonLabel?: string;
}
const { standards, buttonLabel = 'Poproś o kosztorys' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<form
  class="form"
  action="https://api.web3forms.com/submit"
  method="POST"
  novalidate
  data-web3form
  data-success="Dziękujemy! Kosztorys przygotujemy w ciągu kilku dni roboczych."
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="Prośba o wstępny kosztorys — buduje-grupa.eu" />
  <input type="hidden" name="from_name" value="BUDUJE GRUPA — kosztorys" />
  <input type="checkbox" name="botcheck" class="form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form__grid">
    <div class="field">
      <label for="est-area" class="form__label">Metraż *</label>
      <input id="est-area" name="area" type="text" inputmode="numeric" placeholder="np. 120 m²" required />
      <p class="field__error" data-error-for="area">Podaj przybliżony metraż.</p>
    </div>
    <div class="field">
      <label for="est-standard" class="form__label">Standard</label>
      <select id="est-standard" name="standard">
        {standards.map((s, i) => <option selected={i === standards.length - 1}>{s}</option>)}
      </select>
    </div>
    <div class="field field--full">
      <label for="est-location" class="form__label">Lokalizacja działki</label>
      <input id="est-location" name="location" type="text" placeholder="Miejscowość" />
    </div>
    <div class="field">
      <label for="est-name" class="form__label">Imię i nazwisko *</label>
      <input id="est-name" name="name" type="text" autocomplete="name" required minlength="2" />
      <p class="field__error" data-error-for="name">Podaj imię i nazwisko.</p>
    </div>
    <div class="field">
      <label for="est-email" class="form__label">E-mail *</label>
      <input id="est-email" name="email" type="email" autocomplete="email" required />
      <p class="field__error" data-error-for="email">Podaj poprawny adres e-mail.</p>
    </div>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" value="Tak" required />
    <span class="consent__box" aria-hidden="true"><Icon name="check" /></span>
    <span class="consent__text">Wyrażam zgodę na przetwarzanie moich danych w celu przygotowania kosztorysu. *</span>
  </label>
  <p class="field__error" data-error-for="consent">Zgoda jest wymagana.</p>

  <div class="form__footer">
    <button type="submit" class="btn form__submit" data-submit><span data-submit-label>{buttonLabel}</span></button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<script>
  import { initWeb3Forms } from '@/scripts/web3forms';
  initWeb3Forms();
</script>
