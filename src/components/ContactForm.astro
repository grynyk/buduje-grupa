---
/**
 * Contact form (Web3Forms). Layout follows the brand "Napisz do nas" card:
 * name + phone, e-mail, choice chips, message, consent, full-width submit.
 */
import Icon from './Icon.astro';

interface Props {
  /** label above the choice chips, e.g. "Temat" */
  chipsLabel?: string;
  chips?: string[];
  chipsName?: string;
  submitLabel?: string;
  note?: string;
  subject?: string;
  messagePlaceholder?: string;
  id?: string;
}

const {
  chipsLabel = 'Temat',
  chips = [
    'Budowa domu szkieletowego',
    'Płyta fundamentowa / piwnica',
    'Adaptacja projektu',
    'Pozwolenia i formalności',
    'Wycena',
    'Projekt wnętrz',
    'Finansowanie i kredyt',
    'Wizyta na budowie',
    'Inne',
  ],
  chipsName = 'temat',
  submitLabel = 'Wyślij wiadomość',
  note = 'Odpowiadamy najszybciej, jak to możliwe.',
  subject = 'Nowe zapytanie ze strony buduje-grupa.eu',
  messagePlaceholder = 'Kilka słów o domu, który planujesz…',
  id = 'cf',
} = Astro.props;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
if (!accessKey) console.warn('[ContactForm] PUBLIC_WEB3FORMS_KEY is not set — the form will not deliver messages.');
---

<form class="form" action="https://api.web3forms.com/submit" method="POST" novalidate data-web3form>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value="BUDUJE GRUPA — formularz" />
  <input type="checkbox" name="botcheck" class="form__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form__grid">
    <div class="field">
      <label for={`${id}-name`} class="form__label">Imię i nazwisko *</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" placeholder="Jan Kowalski" required minlength="2" />
      <p class="field__error" data-error-for="name">Podaj imię i nazwisko.</p>
    </div>
    <div class="field">
      <label for={`${id}-phone`} class="form__label">Telefon</label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+48" />
    </div>
    <div class="field field--full">
      <label for={`${id}-email`} class="form__label">E-mail *</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="twoj@email.pl" required />
      <p class="field__error" data-error-for="email">Podaj poprawny adres e-mail.</p>
    </div>
  </div>

  {
    chips.length > 0 && (
      // Free-text topic with a custom suggestion dropdown (ARIA combobox): type anything,
      // or pick a suggestion. The list is as wide as the field and filters as you type.
      <div class="field form__topic">
        <label for={`${id}-topic`} class="form__label">
          {chipsLabel}
        </label>
        <div class="combo" data-combo>
          <input
            id={`${id}-topic`}
            name={chipsName}
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`${id}-topics`}
            autocomplete="off"
            placeholder="Wybierz z listy lub wpisz własny temat"
            maxlength="120"
            data-topic-input
          />
          <button type="button" class="combo__toggle" tabindex="-1" aria-label="Pokaż podpowiedzi" data-combo-toggle>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <ul id={`${id}-topics`} class="combo__list" role="listbox" aria-label={chipsLabel} hidden data-combo-list>
            {chips.map((t, i) => (
              <li id={`${id}-topics-${i}`} class="combo__option" role="option" aria-selected="false" data-value={t}>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  <div class="field">
    <label for={`${id}-message`} class="form__label">Wiadomość *</label>
    <textarea id={`${id}-message`} name="message" rows="4" required minlength="10" placeholder={messagePlaceholder}></textarea>
    <p class="field__error" data-error-for="message">Napisz kilka słów (min. 10 znaków).</p>
  </div>

  <label class="consent">
    <input type="checkbox" name="consent" value="Tak" required />
    <span class="consent__box" aria-hidden="true"><Icon name="check" /></span>
    <span class="consent__text">Wyrażam zgodę na przetwarzanie moich danych w celu odpowiedzi na zapytanie. *</span>
  </label>
  <p class="field__error" data-error-for="consent">Zgoda jest wymagana, abyśmy mogli odpowiedzieć.</p>

  <div class="form__footer">
    <button type="submit" class="btn form__submit" data-submit><span data-submit-label>{submitLabel}</span></button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
    {note && <p class="form__note">{note}</p>}
  </div>
</form>

<script>
  import { initWeb3Forms } from '@/scripts/web3forms';
  initWeb3Forms();
</script>
