---
/** Image that opens in the page <Lightbox />. Without JS it links to the file. */
import Icon from '@/components/Icon.astro';

interface Props {
  src: string;
  alt: string;
  /** cover: 16:10 → 21:9 hero image · photo: 4:3 · wide: 4:3 → 21:9 · plan: natural ratio on white (floor plans) */
  variant?: 'cover' | 'photo' | 'wide' | 'plan';
  eager?: boolean;
  class?: string;
}
const { src, alt, variant = 'photo', eager = false, class: className } = Astro.props;
---

<a href={src} class:list={['zoom', `zoom--${variant}`, className]} data-lightbox-item aria-label={`Powiększ: ${alt}`}>
  <img src={src} alt={alt} width="1024" height="1280" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  <span class="zoom__icon" aria-hidden="true"><Icon name="plus" /></span>
</a>

<style lang="scss">
  .zoom {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-alt);
    cursor: zoom-in;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.1s var(--ease-out);
    }

    @include hover {
      img {
        transform: scale(1.03);
      }

      .zoom__icon {
        opacity: 1;
        transform: none;
      }
    }

    &:focus-visible .zoom__icon {
      opacity: 1;
      transform: none;
    }
  }

  .zoom--cover {
    aspect-ratio: 16 / 10;

    @include up(lg) {
      aspect-ratio: 21 / 9;
    }
  }

  .zoom--photo {
    aspect-ratio: 4 / 3;
  }

  .zoom--wide {
    aspect-ratio: 4 / 3;

    @include up(md) {
      aspect-ratio: 21 / 9;
    }
  }

  // floor plans: show the whole drawing, never crop
  .zoom--plan {
    background: var(--c-white);
    border: 1px solid var(--line);

    img {
      height: auto;
      object-fit: contain;
    }

    @include hover {
      img {
        transform: none;
      }
    }
  }

  .zoom__icon {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--c-white);
    color: var(--c-green);
    box-shadow: 0 0 0 1px var(--line);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease-out);

    :global(.icon) {
      width: 1rem;
      stroke-width: 1.5;
    }

    @media (hover: none) {
      opacity: 1;
      transform: none;
    }
  }
</style>
