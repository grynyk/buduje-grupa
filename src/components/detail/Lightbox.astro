---
/**
 * Full-screen photo viewer for every `<a data-lightbox-item href="photo.jpg">` on the page.
 * Native <dialog>: focus is trapped and Esc closes it for free. ←/→ keys, buttons and swipe navigate.
 * Without JS the links simply open the image file.
 */
import Icon from '@/components/ui/Icon.astro';
---

<dialog class="lightbox" aria-label="Galeria zdjęć" data-lightbox>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" data-lightbox-img />
    <figcaption class="lightbox__caption">
      <span data-lightbox-alt></span>
      <span class="lightbox__count" data-lightbox-count></span>
    </figcaption>
  </figure>
  <button type="button" class="lightbox__btn lightbox__btn--prev" aria-label="Poprzednie zdjęcie" data-lightbox-prev>
    <Icon name="arrow-left" />
  </button>
  <button type="button" class="lightbox__btn lightbox__btn--next" aria-label="Następne zdjęcie" data-lightbox-next>
    <Icon name="arrow-right" />
  </button>
  <button type="button" class="lightbox__close" aria-label="Zamknij galerię" data-lightbox-close>
    <Icon name="plus" />
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-item]')];

  if (dialog && items.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const alt = dialog.querySelector<HTMLElement>('[data-lightbox-alt]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const single = items.length < 2;
    let index = 0;

    dialog.classList.toggle('is-single', single);

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      const label = a.querySelector('img')?.alt ?? '';
      img.src = a.href;
      img.alt = label;
      alt.textContent = label;
      count.textContent = single ? '' : `${index + 1} / ${items.length}`;
    };

    items.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      items[index]?.focus();
    });
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    // click on the dark backdrop (outside the photo) closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // swipe
    let startX = 0;
    dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && !single) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style lang="scss">
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1rem, 6vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
    border: 0;
    background: rgb(6 52 36 / 0.96);
    color: var(--c-white);

    &[open] {
      display: grid;
      place-items: center;
    }

    &::backdrop {
      background: transparent;
    }
  }

  .lightbox__figure {
    display: grid;
    gap: 1rem;
    justify-items: center;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    object-fit: contain;
    user-select: none;
  }

  .lightbox__caption {
    display: flex;
    gap: 1.5rem;
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.75);
  }

  .lightbox__count {
    font-variant-numeric: tabular-nums;
  }

  .lightbox__btn,
  .lightbox__close {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    color: var(--c-white);
    transition:
      background 0.3s,
      color 0.3s;

    :global(.icon) {
      width: 1.125rem;
      stroke-width: 1.5;
    }

    @include hover {
      background: var(--c-white);
      color: var(--c-green);
    }
  }

  .lightbox__btn {
    top: 50%;
    transform: translateY(-50%);

    @include down(md) {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }

  .lightbox__btn--prev {
    left: clamp(0.75rem, 2vw, 1.5rem);
  }

  .lightbox__btn--next {
    right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;

    :global(.icon) {
      transform: rotate(45deg);
    }
  }

  .lightbox.is-single .lightbox__btn {
    display: none;
  }
</style>
