---
/** Stroke icon (24×24, currentColor). Paths live in src/lib/icons.ts. */
import { ICONS, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  class?: string;
  /** accessible name; without it the icon is decorative */
  label?: string;
}
const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={ICONS[name]}
/>
