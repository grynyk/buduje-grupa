---
/**
 * Brand logo (vector, from the brand files). Colour follows `currentColor`.
 * - wordmark:     "BUDUJE GRUPA®"  (footer, map card)
 * - mark:         "BG®" monogram   (header)
 * - mark-centred: box = the letters only, ® overflows — use inside circles/badges
 */
import wordmark from '@/assets/brand/logo-wordmark.svg?raw';
import mark from '@/assets/brand/logo-mark.svg?raw';
import { centredMark, decorative } from '@/lib/svg';

interface Props {
  variant?: 'wordmark' | 'mark' | 'mark-centred';
  class?: string;
}
const { variant = 'wordmark', class: className } = Astro.props;
const svg = { wordmark: decorative(wordmark), mark: decorative(mark), 'mark-centred': centredMark }[variant];
---

<span class:list={['logo', `logo--${variant}`, className]} set:html={svg} />

<style lang="scss">
  .logo {
    display: inline-block;
    line-height: 0;
    color: currentColor;

    :global(svg) {
      display: block;
      width: auto;
      height: 100%;
    }
  }

  .logo--wordmark {
    height: 1.25rem;
  }

  .logo--mark-centred {
    height: 1.5rem;
    overflow: visible;
  }

  .logo--mark {
    height: 2rem;
  }
</style>
