---
/**
 * Section / page title with the matching entrance animation.
 *  - as="h1": opens the page — the line rises out of a mask in the hero intro timeline
 *  - h2/h3:   revealed line by line on scroll (SplitText)
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
  id?: string;
}
const { text, as: Tag = 'h2', class: className, id } = Astro.props;
---

{
  Tag === 'h1' ? (
    <h1 class={className} id={id}>
      <span class="mask-line">
        <span data-hero-line>{text}</span>
      </span>
    </h1>
  ) : (
    <Tag class={className} id={id} data-split>
      {text}
    </Tag>
  )
}
