---
/**
 * Beige band above the footer (every page except home). Goes white (`light`) when the page's
 * last section is already beige, so the two don't merge into one block.
 * Texts live in Ustawienia → Menu i stopka → "Pasek nad stopką"; each page picks a variant.
 */
import type { PrefooterVariant } from '@/schemas/common';
import { getLayout } from '@/lib/content';
import { normalizePath } from '@/lib/format';

interface Props {
  variant: Exclude<PrefooterVariant, 'none'>;
  light?: boolean;
}
const { variant, light = false } = Astro.props;
const { prefooter } = await getLayout();
const item = prefooter[variant];
// no "go to Kontakt" button when we are already there
const button = item.button && normalizePath(item.button.href) !== normalizePath(Astro.url.pathname) ? item.button : undefined;
---

<section class:list={['prefooter', light ? 'theme-light' : 'theme-paper', `prefooter--${variant}`]}>
  <div class="container prefooter__inner">
    <div class="prefooter__copy">
      <p class="prefooter__title" data-split>{item.title}</p>
      {item.text && <p class="prefooter__text" data-reveal>{item.text}</p>}
    </div>
    {
      button && (
        <a href={button.href} class="btn prefooter__btn" data-reveal>
          {button.label}
        </a>
      )
    }
  </div>
</section>

<style lang="scss">
  .prefooter {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
  }

  .prefooter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .prefooter__copy {
    display: grid;
    gap: 0.5rem;
    max-width: 44rem;
  }

  .prefooter__title {
    @include display(clamp(1.5rem, 1.2rem + 1.1vw, 2.25rem));
  }

  .prefooter__text {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .prefooter__btn {
    flex: none;
  }
</style>
