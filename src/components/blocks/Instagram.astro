---
/**
 * Instagram posts — each post's official embed page in an <iframe>, sized by CSS.
 *
 * Why not Instagram's embed.js? It creates 2px-tall iframes and only grows them when Instagram's
 * iframe posts its height back; that message can take many seconds or never arrive, leaving an
 * empty section. A direct iframe with a computed height shows the post immediately.
 *
 * Height: Instagram's embed = header + 4:5 photo + footer → width × 1.25 + 206px
 * (measured at 225, 320 and 421px wide). Posts are lazy-loaded natively by the browser.
 */
import instagramIcon from '@/assets/icons/instagram.svg?raw';
import { instagramUrl } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import { decorative } from '@/lib/svg';
import type { BlockOf } from '@/schemas/blocks';

type Props = BlockOf<'instagram'>;
const data = Astro.props;
const settings = await getSettings();
const profile = instagramUrl(settings.socials);
const handle = profile ? `@${new URL(profile).pathname.replace(/\//g, '')}` : undefined;
const icon = decorative(instagramIcon);

// "https://www.instagram.com/p/ID/?utm=…" → "https://www.instagram.com/p/ID/embed/"
const embedUrl = (url: string) => {
  const u = new URL(url);
  return `https://www.instagram.com${u.pathname.replace(/\/?$/, '/')}embed/`;
};
const posts = data.posts.slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="insta theme-light">
      <div class="container">
        <header class="section-head">
          <div class="section-head__text">
            {data.eyebrow && <p class="eyebrow" data-reveal>{data.eyebrow}</p>}
            {data.title && <h2 class="display" data-split>{data.title}</h2>}
            {data.text && <p class="insta__text" data-reveal>{data.text}</p>}
          </div>
          {profile && (
            <a href={profile} class:list={['btn btn--ghost insta__follow', { 'btn--baseline': !data.text }]} target="_blank" rel="noopener noreferrer" data-reveal>
              <span class="insta__icon" set:html={icon} />
              Obserwuj {handle}
            </a>
          )}
        </header>

        <ul role="list" class="insta__row">
          {posts.map((url, i) => (
            <li class="insta__item">
              <iframe
                class="insta__frame"
                src={embedUrl(url)}
                title={`Post ${i + 1} na Instagramie ${handle ?? ''}`.trim()}
                loading="lazy"
                scrolling="no"
                allowtransparency="true"
                referrerpolicy="strict-origin-when-cross-origin"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style lang="scss">
  .insta {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
  }

  .insta__text {
    color: var(--muted);
  }

  .insta__follow {
    gap: 0.6rem;
  }

  .insta__icon {
    display: inline-grid;
    line-height: 0;

    :global(svg) {
      width: 1.125rem;
      height: 1.125rem;
    }
  }

  // 3 equal columns like the project cards; sideways scroll (snap) on phones.
  .insta__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 21rem);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    align-items: start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @include up(md) {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 1.5rem);
      overflow: visible;
    }
  }

  .insta__item {
    min-width: 0;
    scroll-snap-align: start;
    container-type: inline-size; // lets the iframe height follow its own width (cqw)
  }

  .insta__frame {
    display: block;
    width: 100%;
    height: calc(125cqw + 206px);
    border: 1px solid #dbdbdb; // Instagram's own embed border
    border-radius: 3px;
    background: var(--c-white);
  }
</style>
