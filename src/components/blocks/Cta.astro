---
import type { BlockOf } from '@/content.config';

type Props = BlockOf<'cta'>;
const { title, text, button, theme } = Astro.props;
---

<section class:list={['section cta-band', `theme-${theme}`]}>
  <div class="container cta-band__inner">
    <div>
      <h2 class="cta-band__title" data-split>{title}</h2>
      {text && <p class="cta-band__text" data-reveal>{text}</p>}
    </div>
    <a href={button.href} class="btn" data-reveal>{button.label}</a>
  </div>
</section>

<style lang="scss">
  .cta-band {
    padding-block: clamp(3.5rem, 6vw, 5rem);
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .cta-band__title {
    @include display(clamp(1.5rem, 1.25rem + 0.9vw, 2rem));
  }

  .cta-band__text {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
