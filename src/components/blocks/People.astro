---
/**
 * Team.
 *
 *  eyebrow
 *  Title (cols 1–6)                         intro text (cols 8–12, bottom-aligned)
 *  [portrait 4:5]   [portrait 4:5]   [portrait 4:5]      ← equal columns (2 or 3)
 *  Name / ROLE      Name / ROLE      Name / ROLE
 *  ─────────────────────── hairline ───────────────────────
 *  „Quote…”                                     — Signature
 *
 * Portrait: uploaded photo, or initials on brand green until one is added.
 */
import type { BlockOf } from '@/schemas/blocks';
import Img from '@/components/ui/Img.astro';

type Props = BlockOf<'people'>;
const { eyebrow, title, text, quote, signature, items } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
const names = items.map((p) => p.name);
const signedBy = signature || (names.length > 1 ? `${names.slice(0, -1).join(', ')} i ${names.at(-1)}` : names[0]);
const cols = Math.min(Math.max(items.length, 2), 3);
---

<section class="section people theme-light">
  <div class="container">
    <header class="people__head">
      <div class="people__heading">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
        {title && <h2 class="display people__title" data-split>{title}</h2>}
      </div>
      {text && <p class="lead people__text" data-reveal>{text}</p>}
    </header>

    <ul role="list" class="people__list" style={`--cols: ${cols}`} data-reveal-stagger>
      {
        items.map((p) => (
          <li class:list={['person', { 'person--compact': !p.photo }]}>
            {p.photo ? (
              <div class="person__portrait">
                <Img src={p.photo} sizes="(min-width: 1024px) 25vw, 50vw" alt={p.name} loading="lazy" width="800" height="1000" />
              </div>
            ) : (
              <span class="person__avatar" aria-hidden="true">
                {p.initials || initials(p.name)}
              </span>
            )}
            <div class="person__info">
              <h3 class="person__name">{p.name}</h3>
              {p.role && <p class="person__role">{p.role}</p>}
              {p.bio && <p class="person__bio">{p.bio}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {
      quote && (
        <figure class="people__quote" data-reveal>
          <blockquote>
            <p>{quote}</p>
          </blockquote>
          {signedBy && <figcaption>— {signedBy}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style lang="scss">
  .people__head {
    display: grid;
    gap: 1.25rem clamp(1rem, 1.6vw, 1.5rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);

    @include up(lg) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
  }

  .people__heading {
    display: grid;
    gap: 1.25rem;

    @include up(lg) {
      grid-column: 1 / span 6;
    }
  }

  .people__title {
    max-width: 16ch;
  }

  .people__text {
    max-width: 30rem;

    @include up(lg) {
      grid-column: 8 / -1;
    }
  }

  .people__list {
    display: grid;
    gap: 2rem clamp(1rem, 2vw, 1.5rem);

    @include up(sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include up(lg) {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
  }

  .person {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .person__portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.85rem;
    background: var(--c-green);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  // no photo yet: slim card — initials avatar beside the name, hairline on top
  .person--compact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .person__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--c-green);
    color: var(--c-white);
    @include display(1.375rem);
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  .person__info {
    display: grid;
    gap: 0.35rem;
  }

  .person__name {
    @include display(var(--fs-h3));
  }

  .person__role {
    @include label;
    color: var(--muted);
  }

  .person__bio {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* signed statement */
  .people__quote {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);

    @include up(lg) {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 3rem;
    }

    blockquote {
      @include display(clamp(1.75rem, 1.2rem + 2vw, 3rem));
      max-width: 22ch;
    }

    figcaption {
      @include label;
      color: var(--accent);
      white-space: nowrap;
    }
  }
</style>
