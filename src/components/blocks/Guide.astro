---
/**
 * Free guide (lead magnet).
 *  hero    — opens the page: label "Bezpłatny poradnik PDF", h1, intro, topics (left) · form card (right)
 *  closing — green band at the end of the page: title + text (left) · form (right)
 */
import type { BlockOf } from '@/schemas/blocks';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import GuideForm from '@/components/forms/GuideForm.astro';
import GoogleRating from '@/components/ui/GoogleRating.astro';
import Title from '@/components/ui/Title.astro';
import { fadeIn } from '@/lib/motion';

type Props = BlockOf<'guide'>;
const { variant, eyebrow, title, text, topics, formTitle, buttonLabel, note, pdf, showRating, image } = Astro.props;
const hero = variant === 'hero';
const formId = hero ? 'guide-form' : 'guide-form-2';
const reveal = fadeIn(hero);
---

<section class:list={['guide', hero ? 'guide--hero theme-light' : 'guide--closing theme-dark']} data-hero={hero ? '' : undefined}>
  <div class="container guide__grid">
    <div class="guide__intro">
      {eyebrow && <p class="eyebrow" {...reveal}>{eyebrow}</p>}
      <Title as={hero ? 'h1' : 'h2'} text={title} class="guide__title" />
      {text && <p class="guide__text" {...reveal}>{text}</p>}
      {
        topics.length > 0 && (
          <ul role="list" class="guide__topics" data-reveal-stagger>
            {topics.map((t) => (
              <li>
                <Icon name="check" />
                {t}
              </li>
            ))}
          </ul>
        )
      }
      {
        showRating && (
          <div class="guide__rating" data-reveal>
            <GoogleRating />
          </div>
        )
      }
    </div>

    <div class="guide__card" data-reveal>
      {hero && image && <Img class="guide__cover" src={image} sizes="(min-width: 1024px) 50vw, 100vw" alt="" width="1536" height="864" />}
      {formTitle && <p class="guide__form-title">{formTitle}</p>}
      <GuideForm id={formId} buttonLabel={buttonLabel} note={note} pdf={pdf} />
    </div>
  </div>
</section>

<style lang="scss">
  .guide--hero {
    padding-top: var(--page-top);
    padding-bottom: var(--section-y);
  }

  .guide--closing {
    padding-block: var(--section-y);
  }

  .guide__grid {
    display: grid;
    gap: 3rem clamp(1rem, 1.6vw, 1.5rem);

    @include up(lg) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
  }

  .guide__intro {
    display: grid;
    gap: 1.5rem;
    align-content: start;

    @include up(lg) {
      grid-column: 1 / span 6;
    }
  }

  .guide :global(.guide__title) {
    @include display(var(--fs-h1));
    line-height: 1.05;
    max-width: 16ch;
  }

  .guide--closing :global(.guide__title) {
    @include display(var(--fs-h2));
  }

  .guide__text {
    max-width: 34rem;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--muted);
  }

  .guide__topics {
    display: grid;
    border-top: 1px solid var(--line);
    max-width: 34rem;

    li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--line);
    }

    :global(.icon) {
      flex: none;
      width: 1rem;
      height: 1rem;
      stroke-width: 1.5;
      color: var(--accent);
    }
  }

  .guide__rating {
    margin-top: 0.5rem;
  }

  .guide__card {
    --field-bg: var(--c-white);
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--c-paper);

    @include up(lg) {
      grid-column: 8 / -1;
    }
  }

  .guide--closing .guide__card {
    --field-bg: rgb(255 255 255 / 0.08);
    background: var(--c-green-2);
  }

  .guide__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .guide__form-title {
    @include display(var(--fs-h3));
  }
</style>
