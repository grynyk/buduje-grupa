---
import type { BlockOf } from '@/schemas/blocks';
import Icon from '@/components/ui/Icon.astro';

type Props = BlockOf<'packages'>;
const { items, button, includedTitle, included } = Astro.props;
---

<section class="packages">
  <div class="container">
    <ul role="list" class="packages__grid" data-reveal-stagger>
      {
        items.map((p) => (
          <li class:list={['package', p.highlighted ? 'theme-dark package--featured' : 'theme-paper', { 'package--badge': p.badge }]}>
            {p.badge && <span class="package__badge">{p.badge}</span>}
            <h2 class="package__name">{p.name}</h2>
            {/* always rendered: each card needs the same rows for the shared (subgrid) alignment */}
            <p class="package__lead">{p.lead}</p>
            <p class="package__price">{p.price}</p>
            <ul role="list" class="package__features">
              {p.features.map((f) => (
                <li>
                  <Icon name="check" />
                  {f}
                </li>
              ))}
            </ul>
            {button && (
              <a href={button.href} class="btn package__btn">
                {button.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  {
    included.length > 0 && (
      <div class="packages__included theme-paper">
        <div class="container">
          {includedTitle && <p class="eyebrow">{includedTitle}</p>}
          <ul role="list" class="packages__included-list" data-reveal-stagger>
            {included.map((f) => (
              <li>
                <Icon name="check" />
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</section>

<style lang="scss">
  .packages > .container {
    padding-bottom: var(--section-y);
  }

  // Cards share rows (subgrid): name / lead / price / features / button line up across all cards,
  // and every card has the same height.
  .packages__grid {
    display: grid;
    gap: 1.25rem;

    @include up(lg) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(5, auto);
      column-gap: 1.25rem;
      row-gap: 0;
    }
  }

  .package {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.75rem, 2.5vw, 2.25rem);

    @include up(lg) {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 1rem;
    }
  }

  // Badge sits in the corner, out of the flow, so it never pushes content down
  .package__badge {
    position: absolute;
    top: clamp(1.75rem, 2.5vw, 2.25rem);
    right: clamp(1.75rem, 2.5vw, 2.25rem);
    padding: 0.4rem 0.6rem;
    background: var(--c-sage);
    color: var(--c-green);
    @include label;
    font-size: 0.625rem;
  }

  .package__name {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .package--badge .package__name {
    padding-right: 11rem; // keep clear of the corner badge
  }

  .package__lead {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .package__price {
    @include display(clamp(1.5rem, 1.3rem + 0.8vw, 2rem));
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .package__features {
    display: grid;
    gap: 0.7rem;
    font-size: var(--fs-small);

    li {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }

    :global(.icon) {
      flex: none;
      width: 1rem;
      height: 1rem;
      margin-top: 0.15rem;
      stroke-width: 1.5;
    }
  }

  .package__btn {
    align-self: flex-start;
    justify-self: start;
    margin-top: 0.75rem;

    @include up(lg) {
      align-self: end;
    }
  }

  .packages__included {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .packages__included-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
    margin-top: 1.5rem;
    font-size: var(--fs-small);

    li {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }

    :global(.icon) {
      width: 1rem;
      height: 1rem;
      stroke-width: 1.5;
    }
  }
</style>
