---
/**
 * Contact details (Ustawienia firmy) + socials on the left, contact form card on the right.
 *  heading h1 — opens the page (Kontakt) · h2 — a section further down (home page)
 */
import ContactForm from '@/components/forms/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import Title from '@/components/ui/Title.astro';
import { contactRows } from '@/lib/contact';
import { getSettings } from '@/lib/content';
import { fadeIn } from '@/lib/motion';
import type { BlockOf } from '@/schemas/blocks';

type Props = BlockOf<'contact'>;
const { heading, eyebrow, title, text, formTitle, choicesLabel, choices, note, anchor } = Astro.props;
const settings = await getSettings();
const rows = contactRows(settings);
const top = heading === 'h1';
const reveal = fadeIn(top);
---

<section class:list={['contact theme-light', top ? 'contact--top' : 'section']} data-hero={top ? '' : undefined}>
  <div class="container contact__grid">
    <div class="contact__info">
      {eyebrow && <p class="eyebrow" {...reveal}>{eyebrow}</p>}
      {title && <Title as={heading} text={title} class="contact__title" />}
      {text && <p class="lead" {...reveal}>{text}</p>}

      <ul role="list" class="contact__rows" data-reveal-stagger>
        {
          rows.map((r) => (
            <li>
              <span class="contact__icon">
                <Icon name={r.icon} />
              </span>
              <span class="contact__label">{r.label}</span>
              {r.href ? (
                <a
                  href={r.href}
                  class="contact__value"
                  target={r.external ? '_blank' : undefined}
                  rel={r.external ? 'noopener noreferrer' : undefined}
                >
                  {r.value}
                </a>
              ) : (
                <span class="contact__value">{r.value}</span>
              )}
            </li>
          ))
        }
      </ul>

      <SocialLinks socials={settings.socials} class="contact__socials" />
    </div>

    <div class="contact__card" data-reveal>
      {formTitle && <h2 class="contact__card-title">{formTitle}</h2>}
      <ContactForm topicLabel={choicesLabel} topics={choices} note={note} id={anchor ? `${anchor}-form` : 'kontakt'} />
    </div>
  </div>
</section>

<style lang="scss">
  .contact--top {
    padding-top: var(--page-top);
    padding-bottom: var(--section-y);
  }

  .contact__grid {
    display: grid;
    gap: 3rem clamp(3rem, 6vw, 6rem);

    @include up(lg) {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact__info {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact :global(.contact__title) {
    @include display(var(--fs-h2));
  }

  .contact--top :global(.contact__title) {
    @include display(var(--fs-h1));
    line-height: 1.05;
    max-width: 12ch;
  }

  .contact__rows {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);

    li {
      display: grid;
      grid-template-columns: 1.5rem 1fr auto;
      column-gap: 0.75rem;
      align-items: center;
      padding-block: 1rem;
      border-bottom: 1px solid var(--line);
    }
  }

  .contact__icon {
    display: grid;
    place-items: center;
    color: var(--muted);

    :global(.icon) {
      width: 1rem;
      stroke-width: 1.5;
    }
  }

  .contact__label {
    @include label;
    color: var(--muted);
  }

  .contact__value {
    text-align: right;
  }

  a.contact__value {
    justify-self: end;
    background: linear-gradient(currentColor, currentColor) no-repeat right bottom / 0 1px;
    transition: background-size 0.4s var(--ease-out);

    @include hover {
      background-size: 100% 1px;
    }
  }

  .contact__info :global(.contact__socials) {
    --socials-size: 1.375rem;
    margin-top: 0.75rem;
    color: var(--c-green);
  }

  .contact__card {
    --field-bg: var(--c-white);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--c-paper);
  }

  .contact__card-title {
    @include display(var(--fs-h3));
    margin-bottom: 1.5rem;
  }

  @include down(sm) {
    .contact__rows li {
      grid-template-columns: 1.5rem 1fr;
    }

    .contact__value,
    a.contact__value {
      grid-column: 2;
      text-align: left;
      justify-self: start;
    }
  }
</style>
