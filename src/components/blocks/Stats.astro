---
import type { BlockOf } from '@/content.config';

type Props = BlockOf<'stats'>;
const { items, theme } = Astro.props;
---

<section class:list={['stats-block', `theme-${theme}`]}>
  <div class="container">
    <dl class="stats-block__grid" data-reveal-stagger>
      {
        items.map((s) => (
          <div class="stats-block__item">
            <dt class="stats-block__label">{s.label}</dt>
            <dd class="stats-block__value">
              <span class="stats-block__num">{s.value}</span>
              {s.unit && <span class="stats-block__unit">{s.unit}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style lang="scss">
  .stats-block {
    padding-bottom: var(--section-y);
  }

  .stats-block__grid {
    display: grid;
    gap: 2.5rem clamp(1.5rem, 2.5vw, 2rem);

    @include up(md) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .stats-block__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .stats-block__value {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .stats-block__num {
    @include display(clamp(4rem, 2.5rem + 5vw, 7rem));
    font-weight: 200;
    line-height: 1;
  }

  .stats-block__unit {
    @include display(1.5rem);
  }

  .stats-block__label {
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
