---
/** Intro: title + text + highlights beside a photo collage with the BG® seal, then count-up numbers. */
import Icon from '@/components/ui/Icon.astro';
import Img from '@/components/ui/Img.astro';
import Logo from '@/components/ui/Logo.astro';
import { formatNumber } from '@/lib/format';
import { getGooglePlace } from '@/lib/google';
import type { BlockOf } from '@/schemas/blocks';

type Props = BlockOf<'about'>;
const data = Astro.props;
const google = await getGooglePlace();

// Live Google score (when configured) replaces the CMS value in a number whose label mentions "Google".
const stats = data.stats.map((s) =>
  google && /google/i.test(s.label) ? { ...s, value: Math.round(google.rating * 10) / 10, decimals: 1 } : s,
);
---

<section class="about section theme-light">
  <div class="container">
    <div class="about__grid">
      <div class="about__content">
        {data.eyebrow && <p class="eyebrow" data-reveal>{data.eyebrow}</p>}
        <h2 class="about__title" data-split>{data.title}</h2>

        <div class="about__body">
          {data.text && <p class="lead" data-reveal>{data.text}</p>}

          {
            data.highlights.length > 0 && (
              <ul role="list" class="about__highlights" data-reveal-stagger>
                {data.highlights.map((h) => (
                  <li>
                    <span class="about__check">
                      <Icon name="check" />
                    </span>
                    {h}
                  </li>
                ))}
              </ul>
            )
          }

          {
            data.cta && (
              <a href={data.cta.href} class="link-arrow" data-reveal>
                {data.cta.label}
                <Icon name="arrow-right" />
              </a>
            )
          }
        </div>
      </div>

      <div class="about__media">
        <figure class="about__img about__img--main" data-clip-reveal>
          <Img src={data.image} sizes="(min-width: 1024px) 50vw, 100vw" alt={data.imageAlt ?? ''} loading="lazy" width="1024" height="1280" data-parallax="-8" />
        </figure>
        {
          data.imageSecondary && (
            <figure class="about__img about__img--secondary" data-clip-reveal>
              <Img src={data.imageSecondary} sizes="(min-width: 1024px) 33vw, 100vw" alt={data.imageSecondaryAlt ?? ''} loading="lazy" width="1536" height="864" data-parallax="6" />
            </figure>
          )
        }
        {
          data.stamp && (
            <div class="about__stamp" data-rotate aria-hidden="true">
              <svg viewBox="0 0 120 120" width="120" height="120">
                <defs>
                  <path id="stamp-circle" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" />
                </defs>
                <text>
                  <textPath href="#stamp-circle">{data.stamp}</textPath>
                </text>
              </svg>
              <Logo variant="mark-centred" class="about__stamp-logo" />
            </div>
          )
        }
      </div>
    </div>

    {
      stats.length > 0 && (
        <dl class="stats" data-reveal-stagger>
          {stats.map((s) => (
            <div class="stats__item">
              <dt class="stats__label">{s.label}</dt>
              <dd class="stats__value">
                <span data-counter={s.value} data-decimals={s.decimals}>{formatNumber(s.value, s.decimals)}</span>
                {s.suffix && <span class="accent">{s.suffix}</span>}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style lang="scss">
  .about__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);

    @include up(lg) {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
  }

  .about__title {
    @include display(var(--fs-h2));
    margin-top: 1.25rem;
  }

  .about__body {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 36rem;

    @include up(xl) {
      margin-left: 20%;
    }
  }

  .about__highlights {
    display: grid;
    border-top: 1px solid var(--line);

    li {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--line);
    }
  }

  .about__check {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--c-green);

    :global(.icon) {
      width: 1rem;
      height: 1rem;
      stroke-width: 1.5;
    }
  }

  .about__body .link-arrow {
    justify-self: start;
  }

  /* media collage */
  .about__media {
    position: relative;
    padding-bottom: 26%;

    @include up(lg) {
      margin-top: 4rem;
    }
  }

  .about__img {
    overflow: hidden;
    background: var(--bg-alt);

    img {
      width: 100%;
      height: 118%;
      object-fit: cover;
      margin-top: -9%;
    }
  }

  .about__img--main {
    aspect-ratio: 4 / 5;
    width: 82%;
  }

  .about__img--secondary {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 54%;
    aspect-ratio: 1;
    border: clamp(6px, 0.8vw, 10px) solid var(--bg);
  }

  // Outlined "BG"-style seal, as on the brand guarantee card
  .about__stamp {
    position: absolute;
    top: 6%;
    right: 4%;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 10vw, 8.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-white);
    color: var(--c-green);
    box-shadow: inset 0 0 0 1px var(--c-green);

    svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      font-family: var(--f-body);
      font-size: 8.5px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      fill: currentColor;
    }

    :global(.about__stamp-logo) {
      height: clamp(1.25rem, 1.8vw, 1.625rem);
    }
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1rem, 3vw, 3rem);
    margin-top: clamp(4rem, 8vw, 7rem);

    @include up(lg) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stats__value {
    @include display(clamp(3rem, 1.8rem + 4vw, 6rem));
    font-weight: 200;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stats__label {
    @include label;
    color: var(--muted);
    max-width: 22ch;
  }
</style>
