---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import GoogleRating from './GoogleRating.astro';
import { mapUrl, telHref, type Settings } from '@/lib/content';
import { NAV } from '@/lib/nav';

interface Props {
  settings: Settings;
  /** Big faded BUDUJE GRUPA wordmark (home page only). */
  wordmark?: boolean;
}
const { settings, wordmark = false } = Astro.props;
const year = new Date().getFullYear();
const map = mapUrl(settings.socials);
---

<footer class="footer theme-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__col footer__brand">
        <div class="footer__head">
          <Logo class="footer__logo" />
        </div>
        <div class="footer__body">
          {settings.tagline && <p class="footer__tagline">{settings.tagline}</p>}
          <a href="/kontakt" class="btn">Bezpłatna wycena</a>
        </div>
      </div>

      <div class="footer__col footer__col--nav">
        <div class="footer__head"><h2 class="footer__title">Nawigacja</h2></div>
        <ul role="list" class="footer__body footer__nav">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__col footer__col--contact">
        <div class="footer__head"><h2 class="footer__title">Kontakt</h2></div>
        <ul role="list" class="footer__body">
          {settings.phone && <li><a href={telHref(settings.phone)}>{settings.phone}</a></li>}
          {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          {
            settings.address && (
              <li>
                {map ? (
                  <a href={map} target="_blank" rel="noopener noreferrer">
                    {settings.address}
                    <br />
                    {settings.city}
                  </a>
                ) : (
                  <>
                    {settings.address}
                    <br />
                    {settings.city}
                  </>
                )}
              </li>
            )
          }
          {settings.hours && <li>{settings.hours}</li>}
        </ul>
        <!-- icons and rating share one width: icons spread edge to edge above the pill -->
        <div class="footer__connect">
          <SocialLinks socials={settings.socials} class="footer__socials" />
          <GoogleRating compact class="footer__rating" />
        </div>
      </div>
    </div>

    {
      wordmark && (
        <div class="footer__wordmark" aria-hidden="true" data-footer-wordmark>
          <Logo class="footer__wordmark-logo" />
        </div>
      )
    }

    <div class="footer__bottom">
      <p class="footer__copy">© {year} {settings.legalName ?? settings.companyName} · Wszelkie prawa zastrzeżone</p>
      {settings.nip && <p class="footer__legal">{settings.nip}</p>}
      <a href="#main" class="footer__top-link">Do góry <Icon name="arrow-up-right" /></a>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: 2rem;
    overflow: hidden;
  }

  // One 12-column grid shared by the columns AND the bottom row:
  // brand 1–4 · navigation 6–9 · contact 10–12 (ends on the container's right edge)
  .footer__top,
  .footer__bottom {
    --gap: clamp(1rem, 1.6vw, 1.5rem);
    display: grid;
    column-gap: var(--gap);

    @include up(lg) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .footer__top {
    row-gap: 3rem;

    @include up(md) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include up(lg) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .footer__brand {
    @include up(md) {
      grid-column: 1 / -1;
    }

    @include up(lg) {
      grid-column: 1 / span 4;
    }
  }

  .footer__col--nav {
    @include up(lg) {
      grid-column: 6 / span 4;
    }
  }

  .footer__col--contact {
    @include up(lg) {
      grid-column: 10 / -1;
    }
  }

  // shared head row: logo and labels centred on one line; bodies start on one line
  .footer__head {
    display: flex;
    align-items: center;
    height: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .footer__head :global(.footer__logo) {
    height: 1.25rem;
  }

  .footer__title {
    @include label;
    color: var(--muted);
  }

  .footer__body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .footer__brand .footer__body {
    gap: 1.75rem;
    justify-items: start;
  }

  .footer__tagline {
    color: var(--muted);
    max-width: 36ch;
  }

  .footer__nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap, 1.5rem);
  }

  // text links only — buttons keep their own hover (sage fill + green text)
  .footer__col a:not(.btn) {
    transition: color 0.3s;

    @include hover {
      color: var(--accent);
    }
  }

  // Social icons + Google rating as one block, as wide as the rating pill:
  // four outlined pill buttons (same height + radius as the rating) in equal columns
  .footer__connect {
    --pill-h: 2.25rem;
    display: inline-grid;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .footer__connect :global(.footer__socials) {
    --socials-size: 1.125rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .footer__connect :global(.footer__socials a) {
    height: var(--pill-h);
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 99px;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__connect :global(.footer__socials a:hover) {
      background: var(--c-white);
      border-color: var(--c-white);
      color: var(--c-green);
      opacity: 1;
      transform: none;
    }
  }

  .footer__connect :global(.footer__rating) {
    display: flex;
    justify-content: center;
    height: var(--pill-h);
    padding-block: 0;
  }

  // Faded brand wordmark — a quiet signature, not a second headline (home page only)
  .footer__wordmark {
    margin-top: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
    user-select: none;
    color: rgb(255 255 255 / 0.1);

    :global(.footer__wordmark-logo) {
      display: block;
      width: 100%;
      height: auto;
    }

    :global(.footer__wordmark-logo svg) {
      width: 100%;
      height: auto;
    }
  }

  .footer__bottom {
    row-gap: 0.5rem;
    align-items: center;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .footer__copy {
    @include up(lg) {
      grid-column: 1 / span 5;
    }
  }

  .footer__legal {
    @include up(lg) {
      grid-column: 6 / span 4; // under "Nawigacja"
    }
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.4rem;
    color: var(--fg);

    :global(.icon) {
      width: 1rem;
      transform: rotate(-45deg);
    }

    @include up(lg) {
      grid-column: 10 / -1;
      justify-self: end; // container's right edge
    }
  }
</style>
