# Web3Forms public access key (designed to be exposed in client-side code)
PUBLIC_WEB3FORMS_KEY=af842a9e-9df8-478c-a003-b11a2e029329

# Google rating + reviews (Places API New), fetched at build time — server-only, never sent to the browser
GOOGLE_PLACES_API_KEY=
# Optional: the listing's Place ID (if empty, the build looks it up by name once and prints it)
GOOGLE_PLACE_ID=
